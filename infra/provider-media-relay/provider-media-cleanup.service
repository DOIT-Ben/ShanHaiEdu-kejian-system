[Unit]
Description=Remove expired ShanHaiEdu provider media relay files
After=shanhai-provider-media-relay.service

[Service]
Type=oneshot
User=shanhai-dev
Group=shanhai-dev
WorkingDirectory=/opt/shanhaiedu/provider-media-relay
EnvironmentFile=/etc/shanhaiedu/provider-media-cleanup.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/shanhaiedu/provider-media-relay/provider_media_relay.py --cleanup

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/shanhaiedu/runtime/provider-media
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
