# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.10.6@sha256:f75b8eba2090c1dd8758da8201362386f5eda41e7bc1d43ec5b216039650fcda AS uv-runtime
FROM python:3.12.12-slim-bookworm@sha256:2986c55feb36e6cae00fa1fefb454283e4b33f35e75ff8bdd123b134130be301 AS runtime

ARG SHANHAI_RELEASE_SHA
ARG DEBIAN_MIRROR=https://deb.debian.org/debian
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/app/.venv/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

LABEL org.opencontainers.image.title="ShanHaiEdu API" \
      org.opencontainers.image.revision="${SHANHAI_RELEASE_SHA}"

COPY --from=uv-runtime /uv /uvx /usr/local/bin/
COPY infra/prod/configure_debian_mirror.py /tmp/configure_debian_mirror.py
RUN python /tmp/configure_debian_mirror.py \
        "$DEBIAN_MIRROR" /etc/apt/sources.list.d/debian.sources \
    && rm /tmp/configure_debian_mirror.py \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 install --yes --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fonts-dejavu-core \
        fonts-liberation2 \
        gosu \
        libreoffice-impress \
        poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 shanhai \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /app --shell /usr/sbin/nologin shanhai

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY apps ./apps
COPY workers ./workers
COPY workflow ./workflow
COPY contracts ./contracts
COPY alembic ./alembic
COPY alembic.ini ./
RUN uv sync --frozen --no-dev --no-editable \
    && find /app -type d -name __pycache__ -prune -exec rm -rf {} +

COPY --chmod=0555 infra/prod/api-entrypoint.sh /usr/local/bin/shanhai-entrypoint
ENTRYPOINT ["/usr/local/bin/shanhai-entrypoint"]
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
